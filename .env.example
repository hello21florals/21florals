# ============================================================
# 21 FLORALS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env file to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Stripe ───────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Webhook secret — generate with: stripe listen --print-secret
# Or set in Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET

# ── PayPal ───────────────────────────────────────────────────
# Get these from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET

# Set to "live" for production, "sandbox" for testing
PAYPAL_ENV=sandbox
